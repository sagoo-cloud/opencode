{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "vs-dark-bg": "#1e1e1e",
    "vs-dark-bg2": "#252526",
    "vs-dark-bg3": "#2d2d30",
    "vs-dark-panel": "#252526",
    "vs-dark-sidebar": "#252526",
    "vs-dark-text": "#d4d4d4",
    "vs-dark-text-muted": "#969696",
    "vs-dark-border": "#3e3e42",
    "vs-dark-border-active": "#007acc",
    
    "vs-light-bg": "#f8f8f8",
    "vs-light-bg2": "#ffffff",
    "vs-light-bg3": "#f0f0f0",
    "vs-light-panel": "#ffffff",
    "vs-light-sidebar": "#ffffff",
    "vs-light-text": "#383838",
    "vs-light-text-muted": "#6e6e6e",
    "vs-light-border": "#e0e0e0",
    "vs-light-border-active": "#007acc",
    
    "fastcode-green": "#4ec9b0",
    "fastcode-green-bright": "#5fd3ba",
    "fastcode-blue": "#007acc",
    "fastcode-blue-bright": "#0098ff",
    "fastcode-purple": "#c586c0",
    "fastcode-orange": "#ce9178",
    "fastcode-yellow": "#dcdcaa",
    "fastcode-red": "#f44747",
    "fastcode-cyan": "#9cdcfe",
    "fastcode-comment": "#6a9955"
  },
  "theme": {
    "primary": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "secondary": {
      "dark": "fastcode-blue",
      "light": "fastcode-blue"
    },
    "accent": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "error": {
      "dark": "fastcode-red",
      "light": "fastcode-red"
    },
    "warning": {
      "dark": "fastcode-orange",
      "light": "fastcode-yellow"
    },
    "success": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "info": {
      "dark": "fastcode-blue",
      "light": "fastcode-blue-bright"
    },
    "text": {
      "dark": "vs-dark-text",
      "light": "vs-light-text"
    },
    "textMuted": {
      "dark": "vs-dark-text-muted",
      "light": "vs-light-text-muted"
    },
    "selectedListItemText": {
      "dark": "vs-dark-bg",
      "light": "vs-light-bg"
    },
    "background": {
      "dark": "vs-dark-bg",
      "light": "vs-light-bg"
    },
    "backgroundPanel": {
      "dark": "vs-dark-panel",
      "light": "vs-light-panel"
    },
    "backgroundElement": {
      "dark": "vs-dark-bg2",
      "light": "vs-light-bg2"
    },
    "backgroundMenu": {
      "dark": "vs-dark-bg2",
      "light": "vs-light-bg2"
    },
    "border": {
      "dark": "vs-dark-border",
      "light": "vs-light-border"
    },
    "borderActive": {
      "dark": "vs-dark-border-active",
      "light": "vs-light-border-active"
    },
    "borderSubtle": {
      "dark": "#3e3e42",
      "light": "#e0e0e0"
    },
    "diffAdded": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "diffRemoved": {
      "dark": "fastcode-red",
      "light": "fastcode-red"
    },
    "diffContext": {
      "dark": "vs-dark-text-muted",
      "light": "vs-light-text-muted"
    },
    "diffHunkHeader": {
      "dark": "vs-dark-text-muted",
      "light": "vs-light-text-muted"
    },
    "diffHighlightAdded": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "diffHighlightRemoved": {
      "dark": "fastcode-red",
      "light": "fastcode-red"
    },
    "diffAddedBg": {
      "dark": "#1a3a1a",
      "light": "#e0ffe0"
    },
    "diffRemovedBg": {
      "dark": "#3a1a1a",
      "light": "#ffe0e0"
    },
    "diffContextBg": {
      "dark": "vs-dark-bg3",
      "light": "vs-light-bg3"
    },
    "diffLineNumber": {
      "dark": "vs-dark-text-muted",
      "light": "vs-light-text-muted"
    },
    "diffAddedLineNumberBg": {
      "dark": "#1a3a1a",
      "light": "#e0ffe0"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#3a1a1a",
      "light": "#ffe0e0"
    },
    "markdownText": {
      "dark": "vs-dark-text",
      "light": "vs-light-text"
    },
    "markdownHeading": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "markdownLink": {
      "dark": "fastcode-blue",
      "light": "fastcode-blue-bright"
    },
    "markdownLinkText": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "markdownCode": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "markdownBlockQuote": {
      "dark": "fastcode-orange",
      "light": "fastcode-yellow"
    },
    "markdownEmph": {
      "dark": "fastcode-yellow",
      "light": "fastcode-yellow"
    },
    "markdownStrong": {
      "dark": "fastcode-orange",
      "light": "fastcode-green"
    },
    "markdownHorizontalRule": {
      "dark": "#3e3e42",
      "light": "#e0e0e0"
    },
    "markdownListItem": {
      "dark": "fastcode-blue",
      "light": "fastcode-blue"
    },
    "markdownListEnumeration": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "markdownImage": {
      "dark": "fastcode-blue",
      "light": "fastcode-blue-bright"
    },
    "markdownImageText": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "markdownCodeBlock": {
      "dark": "vs-dark-text",
      "light": "vs-light-text"
    },
    "syntaxComment": {
      "dark": "fastcode-comment",
      "light": "fastcode-comment"
    },
    "syntaxKeyword": {
      "dark": "fastcode-blue",
      "light": "#0000ff"
    },
    "syntaxFunction": {
      "dark": "fastcode-yellow",
      "light": "#795e26"
    },
    "syntaxVariable": {
      "dark": "fastcode-cyan",
      "light": "#001080"
    },
    "syntaxString": {
      "dark": "fastcode-orange",
      "light": "#a31515"
    },
    "syntaxNumber": {
      "dark": "fastcode-green",
      "light": "#098658"
    },
    "syntaxType": {
      "dark": "fastcode-green",
      "light": "#267f99"
    },
    "syntaxOperator": {
      "dark": "vs-dark-text",
      "light": "vs-light-text"
    },
    "syntaxPunctuation": {
      "dark": "vs-dark-text",
      "light": "vs-light-text"
    }
  }
}