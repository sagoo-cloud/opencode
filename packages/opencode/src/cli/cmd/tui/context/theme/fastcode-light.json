    "syntaxFunction": {
      "dark": "#795e26",
      "light": "#795e26"
    },
    "syntaxVariable": {
      "dark": "#001080",
      "light": "#001080"
    },
    "syntaxString": {
      "dark": "#a31515",
      "light": "#a31515"
    },
    "syntaxNumber": {
      "dark": "#098658",
      "light": "#098658"
    },
    "syntaxType": {
      "dark": "#267f99",
      "light": "#267f99"
    },
    "syntaxOperator": {
      "dark": "#383838",
      "light": "#383838"
    },
    "syntaxPunctuation": {
      "dark": "#383838",
      "light": "#383838"
    }
