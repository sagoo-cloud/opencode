{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "vs-light-bg": "#f8f8f8",
    "vs-light-bg2": "#ffffff",
    "vs-light-bg3": "#f0f0f0",
    "vs-light-panel": "#ffffff",
    "vs-light-sidebar": "#ffffff",
    "vs-light-text": "#383838",
    "vs-light-text-muted": "#6e6e6e",
    "vs-light-border": "#e0e0e0",
    "vs-light-border-active": "#007acc",
    
    "fastcode-green": "#4ec9b0",
    "fastcode-green-bright": "#5fd3ba",
    "fastcode-blue": "#007acc",
    "fastcode-blue-bright": "#0098ff",
    "fastcode-purple": "#c586c0",
    "fastcode-orange": "#ce9178",
    "fastcode-yellow": "#dcdcaa",
    "fastcode-red": "#f44747",
    "fastcode-cyan": "#9cdcfe",
    "fastcode-comment-light": "#6a9955"
