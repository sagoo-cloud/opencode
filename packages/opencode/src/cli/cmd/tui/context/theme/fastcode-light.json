    "secondary": {
      "dark": "fastcode-blue",
      "light": "fastcode-blue"
    },
    "accent": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "error": {
      "dark": "fastcode-red",
      "light": "fastcode-red"
    },
    "warning": {
      "dark": "fastcode-orange",
      "light": "fastcode-yellow"
    },
    "success": {
      "dark": "fastcode-green",
      "light": "fastcode-green"
    },
    "info": {
      "dark": "fastcode-blue",
      "light": "fastcode-blue-bright"
    },
    "text": {
      "dark": "#383838",
      "light": "#383838"
    },
    "textMuted": {
      "dark": "#6e6e6e",
      "light": "#6e6e6e"
